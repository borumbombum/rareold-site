{
	"name": "oldrare",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run db:sync && npm run data:export && vite build",
		"preview": "vite preview",
		"data:images": "node scripts/download-images.mjs",
		"data:export": "node --env-file-if-exists=.env scripts/db-export.mjs",
		"db:sync": "node --env-file-if-exists=.env scripts/db-sync.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"lucide-svelte": "^1.0.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@inlang/paraglide-js": "^2.23.2",
		"@libsql/client": "^0.17.4",
		"@tiptap/core": "^3.30.1",
		"@tiptap/extension-link": "^3.30.1",
		"@tiptap/extension-placeholder": "^3.30.1",
		"@tiptap/extension-underline": "^3.30.1",
		"@tiptap/pm": "^3.30.1",
		"@tiptap/starter-kit": "^3.30.1",
		"jose": "^6.2.8"
	}
}
