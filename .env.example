# Environment configuration

# Google OAuth (paste the Client ID here; empty = Google login disabled)
# Required in Google Cloud Console: add https://<your-domain>/api/auth/callback
# to the OAuth client's "Authorized redirect URIs" (auto-detected from the request).
# PKCE is used; Google still requires the client secret for web-app clients.
PUBLIC_GOOGLE_CLIENT_ID=""

# Google OAuth client secret (Google Console -> Credentials -> OAuth client -> Client secret).
# Required at the token exchange even with PKCE. Empty = Google login disabled.
GOOGLE_CLIENT_SECRET=""

# Own access-token secret (signs our JWTs). Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Instagram (main traffic source)
PUBLIC_INSTAGRAM_URL="https://instagram.com/rareold"

# Turso (runtime live data: auth, votes, reviews, karma; also used at build).
# Generate a token with:
#   turso db tokens create whiskys-borumbombum
# Set TURSO_URL, TURSO_AUTH_TOKEN and AUTH_SECRET in Vercel too (build + runtime).
TURSO_URL="libsql://whiskys-borumbombum.aws-us-west-2.turso.io"
TURSO_AUTH_TOKEN=""

# IP geolocation provider for first-visit language detection (033).
# Must return JSON with a `country_code` field. Defaults to https://ipwho.is/ (free, no key).
GEO_IP_ENDPOINT="https://ipwho.is/"
